{
  "name": "mir-bim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web-based BIM visualization & 4D/equipment simulation platform (Fuzor-like)",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "test:streaming": "node --test tests/streaming-stability.test.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.108.2",
    "@xeokit/xeokit-sdk": "^2.6.112",
    "3d-tiles-renderer": "^0.5.3",
    "aws4fetch": "^1.0.20",
    "camera-controls": "^3.1.2",
    "docxtemplater": "^3.69.0",
    "dxf-parser": "^1.1.2",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "pizzip": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.9.1",
    "three": "^0.171.0",
    "three-mesh-bvh": "^0.7.8",
    "web-ifc": "0.0.68",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "8.19.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.11"
  }
