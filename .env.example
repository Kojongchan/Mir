# Supabase project credentials (Project Settings → API).
# Copy to ".env" and fill in. NEVER commit the real .env.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- S2 admin console: serverless user management (api/admin.ts) ---
# Set these as SERVER-ONLY env vars in your Vercel project (NOT VITE_*,
# so they never reach the browser). The service_role key is a secret —
# it bypasses RLS, so it must never be committed or exposed client-side.
# Only needed where /api/admin runs (Vercel deploy or `vercel dev`).
# SUPABASE_URL is optional locally; the function falls back to VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY
